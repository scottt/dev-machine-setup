#!/usr/bin/env sh

# Keep our container's fontconfig cache separate from the host's cache to avoid version
# compatibility problems.
export XDG_CACHE_HOME="$HOME/.local/share/antigravity-gui-container-cache"

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    set -- --ozone-platform=wayland --enable-wayland-ime --wayland-text-input-version=3 "$@"
fi

exec /opt/antigravity/antigravity "$@"
