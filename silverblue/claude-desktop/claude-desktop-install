#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR disable=SC2034 # app_* / image / container are read by lib/distrobox-app.sh
#
# Install or update Claude Desktop in a Distrobox. See README.md and
# `claude-desktop-install --help`.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/distrobox-app.sh
. "$script_dir/../lib/distrobox-app.sh"

app_name="Claude"
app_id="claude-desktop"
app_dir="$script_dir"
app_icon="claude-desktop"
app_process="claude-desktop"
image="localhost/claude-desktop:latest"
container="claude"

app_versions() {
	printf 'CLAUDE_VERSION=%s\n' "$(apt_repo_latest \
		https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-amd64/Packages \
		claude-desktop)"
}

# Remove launchers left by earlier versions of this script, and the package's
# own launcher if it was ever exported. Only the GUI launcher should remain.
#
# Deliberately NOT `distrobox-export --app claude-desktop --delete`: it matches
# the package's com.anthropic.Claude.desktop (`Exec=claude-desktop`) and deletes
# the icons that file names, `claude-desktop` — the same icons our claude-gui
# launcher uses, which assembly has just exported. Delete stale files by exact name.
app_remove_stale_launchers() {
	local stale
	for stale in claude claude-claude-desktop claude-com.anthropic.Claude; do
		rm -f "$HOME/.local/share/applications/${stale}.desktop"
	done
}

distrobox_app_main "$@"
